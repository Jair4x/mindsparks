{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mindsparks",
  "version": "0.1.0",
  "identifier": "com.jair4x.mindsparks",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mindsparks",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      },
      {
        "label": "quick-capture",
        "title": "MindSparks Quick Capture",
        "url": "index.html?window=quick-capture",
        "width": 480,
        "height": 160,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
